{
  "name": "moddeck",
  "version": "3.1.0-beta.2",
  "private": true,
  "description": "Open-source local mod manager for 3DMigoto / XXMI games",
  "author": "ModDeck contributors",
  "license": "MIT",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "package:portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "package:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-installer.ps1",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "i18n:check": "node scripts/i18n.mjs check",
    "i18n:sync": "node scripts/i18n.mjs sync",
    "i18n:extract": "node scripts/i18n.mjs extract",
    "i18n:extract:apply": "node scripts/i18n.mjs extract --apply"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-global-shortcut": "^2.4.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
