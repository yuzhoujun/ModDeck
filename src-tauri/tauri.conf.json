{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModDeck",
  "version": "3.0.0-alpha.3",
  "identifier": "dev.moddeck.desktop",
  "build": {
    "beforeDevCommand": "npx vite --config vite.config.ts",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npx vite build --config vite.config.ts",
    "frontendDist": "../out/tauri-renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ModDeck",
        "width": 1220,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "dragDropEnabled": false
      },
      {
        "label": "overlay",
        "create": false,
        "title": "ModDeck Quick",
        "url": "index.html?mode=overlay",
        "width": 460,
        "height": 640,
        "minWidth": 380,
        "minHeight": 420,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "dragDropEnabled": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' http://moddeck.localhost moddeck: asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "../build/icon_32x32.png",
      "../build/icon.png",
      "../build/icon.ico"
    ]
  }
}
